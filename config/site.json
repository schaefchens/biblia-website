{
  "siteName": "Biblia",
  "tagline": {
    "de": "Christliche Schriften zum Lesen, Weitergeben und Bestellen",
    "en": "Christian leaflets to read, share and order"
  },

  "baseUrl": "https://biblia.schaefchens.de/v3/",
  "canonicalDomain": "biblia.at",

  "defaultLanguage": "de",
  "languages": [
    { "code": "de", "label": "Deutsch", "htmlLang": "de-AT", "enabled": true },
    { "code": "en", "label": "English", "htmlLang": "en", "enabled": true },
    { "code": "it", "label": "Italiano", "htmlLang": "it", "enabled": false }
  ],

  "routes": {
    "de": {
      "flyer": "flyer",
      "read": "lesen",
      "text": "text",
      "topics": "themen",
      "categories": "kategorien",
      "order": "bestellen",
      "contact": "kontakt",
      "about": "ueber-uns",
      "imprint": "impressum",
      "privacy": "datenschutz",
      "page": "seite"
    },
    "en": {
      "flyer": "flyer",
      "read": "read",
      "text": "text",
      "topics": "topics",
      "categories": "categories",
      "order": "order",
      "contact": "contact",
      "about": "about",
      "imprint": "imprint",
      "privacy": "privacy",
      "page": "page"
    },
    "it": {
      "flyer": "volantini",
      "read": "leggere",
      "text": "testo",
      "topics": "temi",
      "categories": "categorie",
      "order": "ordinare",
      "contact": "contatto",
      "about": "chi-siamo",
      "imprint": "impressum",
      "privacy": "privacy",
      "page": "pagina"
    }
  },

  "shortRoutes": { "flyer": "f", "reader": "r" },

  "archive": { "perPage": 24 },

  "search": {
    "maxIndexBytesGzip": 153600
  },

  "images": {
    "renderWidth": 2000,
    "coverWidths": [320, 480, 640, 960],
    "readerWidths": [640, 960, 1280, 1800],
    "formats": ["webp", "avif"],
    "quality": { "webp": 78, "avif": 55 },
    "lqipWidth": 16
  },

  "share": {
    "imageSize": { "width": 1200, "height": 630 },
    "statusSize": { "width": 1080, "height": 1920 }
  },

  "order": {
    "enabled": true,
    "defaultCurrency": "EUR",
    "defaultMaxQuantity": 100,
    "recipientEmail": "bestellung@example.invalid",
    "senderEmail": "website@example.invalid"
  },

  "contact": {
    "enabled": true,
    "recipientEmail": "kontakt@example.invalid"
  },

  "retention": {
    "orderDays": 365,
    "contactDays": 180
  },

  "organization": {
    "name": "Biblia",
    "legalName": "Biblia",
    "country": "AT",
    "email": "kontakt@example.invalid"
  }
}
