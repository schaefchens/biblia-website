# Zugangsdaten für das Deployment.
#
# Diese Datei ist nur eine Vorlage. Kopiere sie zu "sftp.env" und trage die
# echten Werte ein. "sftp.env" ist in .gitignore eingetragen und darf niemals
# ins Git-Repository gelangen — sie enthält ein Passwort mit Schreibrechten
# auf den gesamten Webspace.

# Optional. Überschreibt "baseUrl" aus config/site.json.
# Normalerweise leer lassen und die Adresse in config/site.json pflegen.
SITE_BASE_URL=

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=

# Zielverzeichnis auf dem Server, in das der Inhalt von dist/ hochgeladen wird.
# Muss mit einem "/" beginnen und darf nicht "/" allein sein.
SFTP_REMOTE_ROOT=

# --- Redaktionsassistent (npm run assistant) -------------------------------
#
# Nur für den Netzbetrieb (--lan) nötig. Fehlt der Eintrag, wird bei jedem
# Start ein Kennwort erzeugt und im Terminal angezeigt.
BIBLIA_ASSISTANT_PASSWORD=

# Freiwillig: Vorschläge durch eine KI. Ohne Schlüssel bleibt alles andere
# unverändert benutzbar. Der Schlüssel verlässt diesen Rechner nur in
# Richtung des gewählten Dienstes und wird nie an den Browser gesendet.
#
# Einer von beiden genügt. Sind beide hinterlegt, muss BIBLIA_ASSISTANT_AI
# sagen, welcher gelten soll: "claude" oder "openai".
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BIBLIA_ASSISTANT_AI=

# Wahlweise ein anderes Modell.
ANTHROPIC_MODEL=
OPENAI_MODEL=
